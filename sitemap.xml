---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- assign newest = site.posts.first %}
    <url>
        <loc>{{ '/' | absolute_url }}</loc>
        <lastmod>{{ newest.last_edited | default: newest.date | date_to_xmlschema }}</lastmod>
    </url>
    <url>
        <loc>{{ '/about/' | absolute_url }}</loc>
    </url>
    {%- for post in site.posts %}
    <url>
        <loc>{{ post.url | absolute_url }}</loc>
        <lastmod>{{ post.last_edited | default: post.date | date_to_xmlschema }}</lastmod>
    </url>
    {%- endfor %}
</urlset>
